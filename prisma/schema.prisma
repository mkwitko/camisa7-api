// Prisma 7 schema. Datasource URL comes from `prisma.config.ts` (Prisma 7
// removed automatic .env loading + inline `datasource.url`), not from here.
//
// Conventions (see docs/superpowers/plans/2026-07-14-futebol-back-fase-0.md
// "DB Conventions (Prisma 7)" — overrides the company skill's DATABASE.md):
// - uuid-only PK: `id String @id @default(uuid()) @db.Uuid` on every model.
//   The `id` IS the public API identifier (no bigint PK, no separate public
//   uuid, no presenter hiding a PK).
// - Timestamps: `createdAt`/`updatedAt` as `Timestamptz(3)`, UTC.
// - No audit-actor columns (created_by/updated_by), no SYSTEM bootstrap.

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

/// Marketplace V1: account types a `User` opts into at register (and can edit
/// via `PATCH /auth/me/roles`). MULTI (`User.roles Role[]`) — intenção/feature
/// unlock, NÃO fronteira de autorização (o backend segue autorizando por
/// ownership + entitlements). `quadra` liga o `User` às suas `Venue`(s) (gestão
/// na web); `organizador` destrava a criação de grupos/peladas; `jogador` é o
/// default de toda conta.
enum Role {
  jogador
  organizador
  quadra
}

/// Extended in Task 2 (auth): `passwordHash` (own email/password auth, null for
/// Google-only accounts), `googleSub` (Google Sign-In, Task 3+), `expoPushToken`
/// (Task 12). Extended in Task 4: `ownedGroups` (reverse of `Group.ownerId`).
/// Marketplace V1: `roles` (account types, multi) + `venues` (reverse of
/// `Venue.ownerId`, for `quadra` owners).
model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique
  name  String

  roles Role[] @default([jogador])

  passwordHash   String?
  googleSub      String? @unique
  expoPushToken  String?

  /// Correlation to the Stripe customer (billing/entitlements). The ONLY
  /// billing state in our DB — entitlements are resolved live via the Stripe
  /// Entitlements API (+ short in-memory cache), never persisted here.
  stripeCustomerId String?

  /// Marketplace V2: correlation to the Stripe CONNECTED account (Express) of
  /// a `quadra` owner — the only Connect state persisted in our DB.
  /// `charges_enabled` is resolved LIVE (short cache), same convention as
  /// `stripeCustomerId`'s entitlements. `null` = owner hasn't completed the
  /// Stripe-hosted Account Link onboarding yet (booking gated on this).
  stripeAccountId String?

  lastCity String?
  lastLat  Float?
  lastLng  Float?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ownedGroups Group[]
  players     Player[]
  venues      Venue[]
  bookings    Booking[]
}

/// Marketplace V1: uma quadra (arena física) gerida por um `User` com role
/// `quadra`. Gestão acontece na web (`futebol-web`); o app apenas exibe a
/// quadra na descoberta/partida quando `Match.venueId` aponta pra cá. Sem
/// booking/agenda/pagamento (V2+). `latitude`/`longitude` são a fonte de
/// localização copiada pro `Match` quando uma partida é criada com `venueId`.
/// `amenities` é um `String[]` livre validado no boundary HTTP contra o
/// catálogo (`venues/venue.catalog.ts`), não uma constraint de DB. (Fotos = R2,
/// fica pra depois.)
model Venue {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  name      String
  latitude  Float
  longitude Float
  address   String
  city      String
  amenities String[] @default([])
  phone     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  matches Match[]
  courts  Court[]

  @@index([ownerId])
}

/// Marketplace V2: how a `Court`'s booking flow resolves payment. `instant` =
/// pay in full up front and the slot is `confirmed` immediately;
/// `request` = owner must approve before payment is collected
/// (`requested` → owner approves → `pending_payment` → `confirmed`);
/// `deposit` = pay only `Court.depositPercent`% up front, rest settled
/// off-platform (still `confirmed` once the deposit clears).
enum BookingMode {
  instant
  request
  deposit
}

/// Marketplace V2: a `Booking`'s lifecycle. `requested` (mode=request,
/// awaiting owner decision) → `pending_payment` (payment/PIX in flight,
/// 30min TTL) → `confirmed` (paid, or deposit-paid) → `completed` (slot has
/// passed). `cancelled`/`rejected`/`expired` are terminal — the double-
/// booking unique index (`Booking_slot_active_uniq`, hand-SQL) only covers
/// the active states (`requested`,`pending_payment`,`confirmed`,`completed`),
/// so a cancelled/rejected/expired row frees the slot for a new booking.
enum BookingStatus {
  requested
  pending_payment
  confirmed
  completed
  cancelled
  rejected
  expired
}

/// Marketplace V2: a bookable court belonging to a `Venue`. `bookingMode`
/// picks the payment flow (see `BookingMode`); `depositPercent` only applies
/// when `bookingMode = deposit` (1..100, validated at the HTTP boundary, not
/// a DB constraint). `slotMinutes` is the fixed grid size (default 60) that
/// `Booking.startMinute`/`endMinute` snap to. `priceRules` resolves a slot's
/// price by weekday + time-of-day; `active = false` hides the court from
/// booking without deleting its history.
model Court {
  id      String @id @default(uuid()) @db.Uuid
  venueId String @db.Uuid
  venue   Venue  @relation(fields: [venueId], references: [id])

  name           String
  modality       Modality    @default(campo)
  surface        String?
  slotMinutes    Int         @default(60)
  bookingMode    BookingMode @default(instant)
  depositPercent Int? // usado só quando bookingMode = deposit (1..100)
  active         Boolean     @default(true)

  priceRules CourtPriceRule[]
  bookings   Booking[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([venueId])
}

/// Marketplace V2: one weekday+time-window price band for a `Court` — a
/// court can have multiple rules (e.g. weekday daytime vs weekend night).
/// Resolved at booking time by matching the slot's weekday + startMinute
/// against these windows (service layer, not a DB constraint).
model CourtPriceRule {
  id      String @id @default(uuid()) @db.Uuid
  courtId String @db.Uuid
  court   Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  weekday     Int // 0=Dom .. 6=Sáb
  startMinute Int // minutos desde 00:00
  endMinute   Int
  priceCents  Int

  @@index([courtId, weekday])
}

/// Marketplace V2: one reserved slot on a `Court`, booked by a `User`. Price
/// is captured at booking time (`priceCents`, resolved from
/// `CourtPriceRule` — later rule changes don't retroactively alter an
/// existing booking). `depositCents` only set when `mode = deposit`.
/// `stripePaymentIntentId` correlates to the Stripe destination-charge
/// PaymentIntent (PIX) once payment starts. Double-booking is prevented by
/// a hand-SQL PARTIAL unique index (`Booking_slot_active_uniq`, covering
/// only active `status` values) — Prisma's schema DSL can't express partial
/// uniqueness, same convention as `Attendance`'s `attendance_active_unique`.
/// `match` (reverse of `Match.bookingId`) links a confirmed booking to the
/// pelada scheduled on it, once that flow exists.
model Booking {
  id      String @id @default(uuid()) @db.Uuid
  courtId String @db.Uuid
  court   Court  @relation(fields: [courtId], references: [id])

  bookedById String @db.Uuid
  bookedBy   User   @relation(fields: [bookedById], references: [id])

  date         DateTime      @db.Date
  startMinute  Int
  endMinute    Int
  priceCents   Int
  mode         BookingMode
  status       BookingStatus @default(pending_payment)
  depositCents Int?

  stripePaymentIntentId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  match Match?

  @@index([courtId, date])
  @@index([bookedById])
}

/// Fase 0 only issues `organizador` (single-owner stats). `colaborativo`
/// (shared editing) is a later fase — the enum value exists now so the
/// column never needs a widening migration.
enum GroupStatsMode {
  organizador
  colaborativo
}

/// Geo G3 (descoberta pública): how strangers join a PUBLIC group's matches.
/// `open` = confirm directly (any authenticated user); `request` = ask and
/// the organizer approves (JoinRequest, Fase 2). Only meaningful when
/// `Group.isPublic` is true — a private group always requires membership.
enum JoinPolicy {
  open
  request
}

/// Task 4: Arena — an owner-scoped group of players. `id` is the public API
/// identifier (uuid-only PK convention, see header). Ownership authorization
/// (`assertGroupOwner` in `src/http/api/groups/groups.authz.ts`) is the
/// primitive reused by Tasks 5,6,8,9,10,11 — every child resource under a
/// group re-checks `group.ownerId === userId` the same way.
model Group {
  id   String @id @default(uuid()) @db.Uuid
  name String

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  statsMode GroupStatsMode @default(organizador)

  /// Task 1 (Mensalista vs Avulso): default monthly fee for `mensalista`
  /// members of this group, in cents. `null` means the group hasn't set one
  /// yet. A `GroupMember` can override it via
  /// `GroupMember.monthlyFeeCentsOverride`.
  monthlyFeeCents Int?

  /// Geo G3 (descoberta pública): a public group's `open`/`upcoming` matches
  /// surface in `GET /discover`. Setting `true` requires the `public_groups`
  /// entitlement (`ERRORS.GRP.PUBLIC_REQUIRES_PLAN`, enforced in
  /// `update-group.service`). `joinPolicy` governs how strangers join those
  /// matches (see `JoinPolicy`); it only takes effect while `isPublic`.
  isPublic   Boolean    @default(false)
  joinPolicy JoinPolicy @default(open)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members GroupMember[]
  matches Match[]
  series  MatchSeries[]

  @@index([ownerId])
}

/// Task 5: on-field position (goalkeeper..striker). `secondaryPos` on
/// `GroupMember` and the `affinity`/`seedOverall` JSON key sets are both
/// constrained to this same set — the balancer (Task 10) consumes it.
enum Position {
  goleiro
  zagueiro
  lateral
  volante
  meia
  atacante
}

/// Match modality (Task: modalidade) — determines which field positions apply.
enum Modality {
  futsal
  society
  campo
}

/// Dominant foot (card field).
enum Foot {
  left
  right
  both
}

/// Task 5: a member's role inside one specific group (not a global role).
enum MemberRole {
  organizador
  jogador
}

/// Task 5: a person known to the app — either a registered `User` (`userId`
/// set) or a guest added directly by a group organizer (`userId` null, no
/// login). One `Player` can be linked to at most one `User` (via
/// `findOrCreateForUser` in `players.repository.ts`, reused across the same
/// user's groups) — F1-5 closes a Fase 0 TOCTOU gap by making this a REAL DB
/// constraint via a hand-written PARTIAL unique index
/// (`player_user_unique`, covering only non-null `userId`s — see
/// `prisma/migrations/20260715150000_player_user_unique/migration.sql`;
/// Prisma's schema DSL can't express partial uniqueness, so there's no
/// matching `@@unique` here, same as `Attendance`'s
/// `attendance_active_unique`). Guests keep `userId` null, never constrained
/// (many guests, no `User` at all — nothing to enforce uniqueness against).
/// `findOrCreateForUser` catches the P2002 this index can now raise (two
/// concurrent calls racing to provision the same user's `Player`) and
/// re-`findFirst`s instead of surfacing a 500.
model Player {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  name  String
  phone String?

  /// Slug público único para URLs compartilháveis (`/j/:slug`) — ver
  /// `player-slug.ts`. Backfill na migração para os players existentes.
  slug String @unique

  /// Avatar (foto de perfil) — URL pública no R2. `null` = sem foto (usa
  /// monograma). Enviada pelo próprio jogador via presigned upload.
  avatarUrl String?

  /// Task 1 (UX overhaul, FM rating model): the player's own self-declared
  /// affinity map (`{position: 0-100}`) — the N positions they play and how
  /// good they judge themselves at each, filled in by the player, never set
  /// by an organizer. Empty (`{}`) until the player declares it.
  affinity Json @default("{}")

  /// Onboarding (descriptive only, never feeds the balancer): the player's
  /// self-declared attribute budget — a `{attribute: 0-100}` map over the
  /// fixed catalog (`players.catalog.ts`), all starting at 50 with a fixed
  /// total budget the player redistributes. Empty (`{}`) until declared; the
  /// presenter fills the 50-baseline defaults so responses always carry the
  /// full map.
  attributes Json @default("{}")

  /// Onboarding (descriptive only): up to N self-declared skill tags from a
  /// fixed catalog (`players.catalog.ts`), e.g. `["driblador","goleador"]`.
  /// Rendered as badges on the profile/card, never consumed by the balancer.
  skills String[] @default([])

  /// Card fields (FIFA-style profile) — all optional, descriptive.
  dominantFoot  Foot?
  weakFoot      Int? /// 1-5 stars
  skillMoves    Int? /// 1-5 stars (fintas)
  heightCm      Int?
  weightKg      Int?
  birthYear     Int?
  preferredTeam String?
  nationality   String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships        GroupMember[]
  attendances        Attendance[]
  stats              MatchStat[]
  votesCast          Vote[]           @relation("VoteVoter")
  votesReceived      Vote[]           @relation("VoteVoted")
  career             PlayerCareer?
  joinRequests       JoinRequest[]
  reputationGiven    ReputationTag[]  @relation("ReputationVoter")
  reputationReceived ReputationTag[]  @relation("ReputationVoted")

  @@index([userId])
}

/// Task 5: a `Player`'s membership in one `Group`, carrying the carreira-ready
/// rating data (positions + affinity + seed overall) the balancer (Task 10)
/// consumes. `affinity`/`seedOverall` are `Json` maps keyed by `Position`
/// values (validated at the HTTP boundary via Zod, not a DB constraint).
model GroupMember {
  id String @id @default(uuid()) @db.Uuid

  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  role         MemberRole
  /// Task 1 (UX overhaul): nullable — the organizer no longer sets this at
  /// add-member time; it is null until the player links their account and
  /// fills their own sporting profile.
  primaryPos   Position?
  secondaryPos Position[]
  affinity     Json       @default("{}")
  seedOverall  Json       @default("{}")

  /// Task 1 (Mensalista vs Avulso): `mensalista` members owe a recurring
  /// `MembershipDue` per competency month; `avulso` (default, covers all
  /// pre-existing rows) pay per-match instead. `monthlyFeeCentsOverride`
  /// takes precedence over `Group.monthlyFeeCents` when set.
  billingMode             BillingMode @default(avulso)
  monthlyFeeCentsOverride Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  dues MembershipDue[]

  @@unique([groupId, playerId])
}

/// Task 1 (Mensalista vs Avulso): a `GroupMember`'s billing arrangement.
/// `mensalista` owes a recurring `MembershipDue` per competency month;
/// `avulso` (default) pays per-match instead, same as every pre-existing
/// row before this feature.
enum BillingMode {
  mensalista
  avulso
}

/// Task 1 (Mensalista vs Avulso): a `MembershipDue`'s payment state. `paid`
/// is set once the group owner (or an organizer) confirms receipt —
/// `MembershipDue.paidConfirmedById` records who did it, same convention as
/// `Attendance.paidConfirmedById`/`PaymentStatus`.
enum DueStatus {
  pending
  paid
}

/// Task 1 (Mensalista vs Avulso): how a `MembershipDue` was (or will be)
/// settled. `manual` is the only value this task's flows ever write —
/// `stripe` is a later integration; the enum value exists now so this
/// column never needs a widening migration when that lands.
enum DueProvider {
  manual
  stripe
}

/// Task 1 (Mensalista vs Avulso): one `mensalista` `GroupMember`'s monthly
/// due for one competency month (`competencyMonth`, e.g. "2026-07") — the
/// `@@unique([groupMemberId, competencyMonth])` makes generating/re-running
/// the monthly charge idempotent per member per month. `amountCents` is
/// captured at generation time (from `GroupMember.monthlyFeeCentsOverride`
/// or `Group.monthlyFeeCents`) so a later change to either doesn't retroactively
/// alter an already-generated due. `paidConfirmedById` is a plain uuid
/// column (no FK relation), same convention as
/// `Attendance.paidConfirmedById`/`MatchResult.recordedById`.
model MembershipDue {
  id String @id @default(uuid()) @db.Uuid

  groupMemberId String      @db.Uuid
  groupMember   GroupMember @relation(fields: [groupMemberId], references: [id])

  competencyMonth   String
  amountCents       Int
  status            DueStatus   @default(pending)
  paidConfirmedById String?     @db.Uuid
  provider          DueProvider @default(manual)
  externalRef       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupMemberId, competencyMonth])
  @@index([groupMemberId])
}

/// Task 1 (Motor de Recorrência): lifecycle of a `MatchSeries`. `active` is
/// the only status the recurrence job spawns matches for; `paused` stops
/// generation without deleting history; `ended` is terminal (past
/// `endDate`, or organizer-stopped).
enum SeriesStatus {
  active
  paused
  ended
}

/// Task 1 (Motor de Recorrência): a recurring schedule (e.g. "toda
/// quarta-feira às 20h") that spawns `Match` rows — replaces the old
/// `Match.recurrenceRule` Json field (dropped in this same migration,
/// backfilled into one `MatchSeries` per existing recurring match). `rule`
/// is a `Json` shape validated at the HTTP boundary (Zod), not a DB
/// constraint. `Match.seriesId` is nullable (one-off matches have no
/// series) and `Match.detached` lets an organizer edit a single occurrence
/// without affecting the rest of the series.
model MatchSeries {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  rule       Json
  time       String?
  location   String
  priceCents Int          @default(0)
  slots      Int
  pixKey     String?
  status     SeriesStatus @default(active)
  startDate  DateTime     @db.Timestamptz(3)
  endDate    DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  matches Match[]

  @@index([groupId])
  @@index([status])
}

/// Task 6: a scheduled pelada. `full` (slots reached) / `closed` (organizer
/// locked it manually) are set by Task 7's attendance flow, not here; `open`
/// is the only status this task's create-match ever sets. `finished` is set
/// by a later task once the match's `datetime` has passed (Task 11's
/// recurrence job also reads `finished` to spawn the next occurrence).
enum MatchStatus {
  open
  full
  closed
  finished
  cancelled
}

/// Task 6: a match (pelada) scheduled inside a `Group` — the aggregate that
/// attendance (Task 7), PIX charges, invites, teams and recurrence (Tasks
/// 8-11) hang off. Only the group's owner manages it (`assertMatchOwner` in
/// `src/http/api/matches/matches.authz.ts`, reusing `assertGroupOwner` on the
/// match's parent group). `seriesId` links a spawned occurrence back to its
/// `MatchSeries` (Task 1, Motor de Recorrência; replaces the old
/// `recurrenceRule` Json column) — `null` means a one-off match. `detached`
/// lets an organizer edit/cancel a single occurrence without affecting the
/// rest of the series (the recurrence job skips detached matches).
model Match {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  datetime   DateTime    @db.Timestamptz(3)
  location   String
  priceCents Int         @default(0)
  slots      Int
  pixKey     String?
  status     MatchStatus @default(open)
  modality   Modality    @default(campo)

  latitude  Float?
  longitude Float?
  city      String?
  address   String?

  seriesId String?      @db.Uuid
  series   MatchSeries? @relation(fields: [seriesId], references: [id])
  detached Boolean      @default(false)

  /// Marketplace V1: partida pode apontar pra uma `Venue` (quadra). Ao criar
  /// com `venueId`, o service copia `latitude/longitude/city/address` da Venue
  /// (fonte da localização, sobrepõe coords manuais). `null` = partida sem
  /// quadra vinculada.
  venueId String? @db.Uuid
  venue   Venue?  @relation(fields: [venueId], references: [id])

  /// Marketplace V2: partida pode ter nascido de (ou estar amarrada a) uma
  /// `Booking` confirmada na quadra. `null` = partida sem booking associado
  /// (fluxo V1 continua funcionando sem quadra/booking).
  bookingId String?  @unique @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  attendances    Attendance[]
  inviteTokens   InviteToken[]
  teamAssignment TeamAssignment?
  result         MatchResult?
  stats          MatchStat[]
  votes          Vote[]
  joinRequests   JoinRequest[]
  reputationTags ReputationTag[]

  @@index([groupId, datetime])
  @@unique([seriesId, datetime])
}

/// Task 7: an attendee's state for one `Match`. `confirmed` counts against
/// `Match.slots`; `waitlisted` carries a 1-based `waitlistPos` (lowest = next
/// to promote); `cancelled` is terminal (a cancelled row never comes back —
/// re-confirming inserts fresh, gated by the partial unique index below so a
/// player can only have one *active* — confirmed/waitlisted — row per match
/// at a time).
enum AttendanceStatus {
  confirmed
  waitlisted
  cancelled
}

/// Task 8: PIX payment confirmation state for a `confirmed` attendee. `paid`
/// is set by `setPayment` once the group owner (or an organizer) marks the
/// attendee's payment as received; `paidConfirmedById` (on `Attendance`)
/// records who did it.
enum PaymentStatus {
  pending
  paid
}

/// Task 7: an attendee's slot/waitlist state for a `Match` — the
/// concurrency-critical aggregate. Every state transition (`confirm`,
/// `cancelAndPromote`) runs inside one interactive `prisma.$transaction`
/// that locks the parent `Match` row first (`SELECT ... FOR UPDATE` — see
/// `attendance.repository.ts`), so two concurrent confirms can never both
/// take the last slot. Prisma's schema DSL can't express a *partial* unique
/// index, so the real constraint enforcing "at most one active (non
/// cancelled) row per (matchId, playerId)" is hand-added as raw SQL in this
/// model's migration (`attendance_active_unique`) — see the migration file's
/// header comment for why it can't live here.
model Attendance {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  status      AttendanceStatus
  waitlistPos Int?

  paymentStatus     PaymentStatus @default(pending)
  paidConfirmedById String?       @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([matchId])
  @@index([playerId])
}

/// Task 9: a shareable link an owner mints for one `Match` — the viral-loop
/// surface. A guest (no account) resolves it via the public `GET
/// /invite/:token` and confirms presence via the public `POST
/// /invite/confirm`, which creates a guest `Player` (`userId` null) and runs
/// the same race-safe `AttendanceRepository.confirm` flow Task 7 uses for
/// authenticated confirms. `token` is a `nanoid(16)` string minted by
/// `invites.repository.ts`'s `create` — that same method reuses the existing
/// row for a match instead of minting a new one on every call, so there's no
/// uniqueness constraint on `matchId` (one row is the steady state, but
/// nothing in the schema itself forbids more).
model InviteToken {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  token String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([matchId])
}

/// Task 10: the last-generated (or owner-overridden) team split for a
/// `Match` — one row per match (`matchId` unique; `TeamsRepository.save` is
/// an upsert keyed by `matchId`, so `generate-teams`/`update-teams` always
/// replace the same row rather than accumulate history). `teams` is a `Json`
/// array shaped `{ team: number; players: { playerId: string; name: string
/// }[] }[]` — produced by the pure `balanceTeams` (`children/teams/
/// balancer.ts`) or by `update-teams`'s own "every confirmed player exactly
/// once" check, not a DB constraint. `updatedAt` doubles as the domain
/// `TeamAssignment.generatedAt` (every `save` bumps it, whether from a fresh
/// generation or a manual override).
model TeamAssignment {
  id String @id @default(uuid()) @db.Uuid

  matchId String @unique @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  teams Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Task 14 (Fase 1): closes out a `Match` — the owner-recorded final score.
/// One row per match (`matchId` unique; `MatchResultRepository.upsert` is an
/// upsert keyed by `matchId`, so `record-result` can correct a mistaken entry
/// by resubmitting rather than accumulating history). `scores` is a `Json`
/// array shaped `{ team: number; goals: number }[]` — same `{ team, ... }[]`
/// convention `TeamAssignment.teams` uses, validated at the HTTP boundary
/// (Zod) plus cross-checked in the service against the match's persisted
/// `TeamAssignment` (if one exists) so a score can't reference a team that
/// was never on the pitch. `winnerTeam` is the winning team's index;
/// `null` means a draw. `recordedById` is the acting `User.id` — plain uuid
/// column, no FK relation, same convention as `Attendance.paidConfirmedById`.
/// Recording a result requires the match to already be `status: "finished"`
/// (via `finish-match`, Fase 0) — `record-result` doesn't itself transition
/// match status, it only closes out the score for an already-finished match.
model MatchResult {
  id String @id @default(uuid()) @db.Uuid

  matchId String @unique @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  scores     Json
  winnerTeam Int?

  recordedById String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Task 15 (Fase 1): F1-2 organizer-logged per-player stats for a `Match`.
/// Fase 1 only ever writes `source: "organizador"` (the owner logs
/// gols/assist/clean_sheet after the match) — `colaborativo` (jogadores
/// reportam + consenso/disputa, `stat_report`) is a later fase; the enum
/// value exists now so this column never needs a widening migration when
/// that feature lands (see §4.2/§9 of the Fase 0+1 design doc).
enum MatchStatSource {
  organizador
  colaborativo
}

/// Task 15 (Fase 1): one player's stat line for one `Match` — `log-stats`
/// upserts a batch of these keyed by `(matchId, playerId)`
/// (`MatchStatsRepository.upsertMany`), so re-logging the same player
/// corrects the row rather than accumulating history (same "upsert to
/// correct" convention `MatchResult`/`TeamAssignment` use). `team` is the
/// same 0-based index `TeamScore.team`/`TeamSplit.team` use — optional
/// since not every group runs `generate-teams` before logging stats.
/// `cleanSheet` only makes sense for a goalkeeper but isn't itself
/// constrained to `Position.goleiro` at the DB level (validated, if at all,
/// at the HTTP boundary). `listByPlayer` (career-wide, ignores `matchId`)
/// feeds the F1-4 career-growth engine (`player_career`, §6 of the design
/// doc) once it lands.
model MatchStat {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  team       Int?
  goals      Int             @default(0)
  assists    Int             @default(0)
  ownGoals   Int             @default(0)
  cleanSheet Boolean         @default(false)
  source     MatchStatSource @default(organizador)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([matchId, playerId])
  @@index([playerId])
}

/// Task 16 (Fase 1, F1-3): the 4 post-game recognition categories a
/// confirmed attendee can vote for. `craque` is Portuguese for the match's
/// standout player (distinct from `mvp` — the design doc's §4.2 lists them
/// as separate categories); `fair_play` feeds a reputation signal (§6)
/// that's kept separate from the technical `overall` a `craque`/`mvp` vote
/// nudges.
enum VoteCategory {
  mvp
  melhor_goleiro
  craque
  fair_play
}

/// Task 16 (Fase 1, F1-3): one player's vote, for one category, on one
/// `Match` — `cast-vote` upserts keyed by `(matchId, voterPlayerId,
/// category)` (`VotesRepository.upsert`), so changing your mind within the
/// 48h voting window (§5.2 step 10 of the design doc) corrects the same row
/// rather than accumulating history (same "upsert to correct" convention
/// `MatchResult`/`MatchStat` use). Both `voterPlayerId` and `votedPlayerId`
/// point at `Player` — two separate relations (`VoteVoter`/`VoteVoted`,
/// named since Prisma requires disambiguation for two FKs to the same
/// model), mirrored by `Player.votesCast`/`Player.votesReceived`. The
/// service layer (`cast-vote.service.ts`), not a DB constraint, enforces
/// that both players are CONFIRMED attendees of `matchId` and that
/// `voterPlayerId !== votedPlayerId` (no self-vote) — Prisma's schema DSL
/// can't express either check. Individual rows are never exposed over the
/// API (`list-vote-tally` only returns aggregated counts, see
/// `votes.repository.ts`'s `tallyByMatch`) — voter identity per vote stays
/// private, only `listByMatch` (internal, feeds the F1-4 career-growth
/// engine's MVP/craque counts) reads the raw rows.
model Vote {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  voterPlayerId String @db.Uuid
  voter         Player @relation("VoteVoter", fields: [voterPlayerId], references: [id])

  category VoteCategory

  votedPlayerId String @db.Uuid
  voted         Player @relation("VoteVoted", fields: [votedPlayerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([matchId, voterPlayerId, category])
  @@index([matchId])
  @@index([votedPlayerId])
}

/// Fase 1 (reputação): the 4 positive-only dimensions a voter can tag a
/// teammate with, post-match (`set-reputation`). No downvote — see
/// `ReputationTag`.
enum ReputationDimension {
  pontualidade
  educacao
  compromisso
  respeito
}

/// Reputação positiva (só tags, sem downvote): um presente confirmado marca um
/// companheiro numa dimensão. Contagem de tags recebidas = a reputação. Regras
/// de janela/participante iguais às de `Vote` (ver reputation/set-reputation).
model ReputationTag {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  voterPlayerId String @db.Uuid
  voter         Player @relation("ReputationVoter", fields: [voterPlayerId], references: [id])

  votedPlayerId String @db.Uuid
  voted         Player @relation("ReputationVoted", fields: [votedPlayerId], references: [id])

  dimension ReputationDimension

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([matchId, voterPlayerId, votedPlayerId, dimension])
  @@index([votedPlayerId])
  @@index([matchId])
}

/// Task 17 (Fase 1, F1-4): a player's GLOBAL, cross-group identity — 1:1 with
/// `Player`, materialized for any player (registered or guest; guest→account
/// merge is F1-5). Grows deterministically off match history via the pure
/// growth engine (`src/http/api/players/children/career/career-engine.ts`),
/// replayed by `PlayerCareerRepository.recomputeForPlayer` (triggered by
/// `POST /matches/:id/finalize` and the finalize cron, `src/jobs/
/// finalize-matches.job.ts`) — never mutated incrementally, so recomputing
/// twice from the same match history yields the same row (idempotent).
/// `attributes` is a `Json` map of the player's evolved per-position
/// attributes (single-overall model, `career-engine.ts`); `affinity` is a
/// `Json` map keyed by `Position` (0-100), same convention
/// `GroupMember.seedOverall`/`affinity` use — `affinity` is player-declared
/// (set outside this task's scope) and the engine never writes it, only
/// `attributes`. `level` is derived from the best evolved position overall
/// (computed from `attributes`) via `career-config.ts`'s thresholds. `currentStreak` is the
/// player's active unbeaten (win/draw) run as of their most recent finalized
/// match; `bestStreak` is the historical max.
model PlayerCareer {
  id String @id @default(uuid()) @db.Uuid

  playerId String @unique @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  attributes Json @default("{}")
  affinity   Json @default("{}")

  level PlayerLevel @default(bronze)

  matchesPlayed Int @default(0)
  wins          Int @default(0)
  draws         Int @default(0)
  losses        Int @default(0)
  goals         Int @default(0)
  assists       Int @default(0)
  cleanSheets   Int @default(0)
  mvpCount      Int @default(0)
  currentStreak Int @default(0)
  bestStreak    Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Task 17 (Fase 1, F1-4): `PlayerCareer.level` — derived (never set
/// directly by a caller) from the player's best evolved position overall
/// (computed from `attributes`) via `career-config.ts`'s `LEVEL_THRESHOLDS`.
/// bronze is the default for a brand-new career (bootstrap seed, or no
/// positions touched yet).
enum PlayerLevel {
  bronze
  prata
  ouro
}

/// Geo G3 (Fase 2, descoberta pública): the decision state of a request to
/// join one PUBLIC group's match whose `Group.joinPolicy` is `request`. A
/// stranger opens a `pending` request (`POST /matches/:id/join-request`); the
/// match's group owner approves (→ `approved`, which also creates the
/// `Attendance` + fires a push) or rejects it (→ `rejected`).
enum JoinRequestStatus {
  pending
  approved
  rejected
}

/// Geo G3 (Fase 2): a request to join one `Match` of a PUBLIC group whose
/// `joinPolicy` is `request` — only meaningful for that policy (an `open`
/// group's matches are joined directly via `confirm-presence`). The
/// `@@unique([matchId, playerId])` is a FULL unique (one row per
/// match+player ever, unlike `Attendance`'s partial `active` index): a
/// request that was `rejected`/`approved` is REOPENED in place (status back
/// to `pending`, `decidedById` cleared) rather than inserting a second row,
/// so the same player can ask again after a rejection without violating the
/// constraint (see `join-request.service.ts`'s `requestJoin`). `decidedById`
/// is the acting owner `User.id` — a plain uuid column with no FK relation,
/// same convention as `Attendance.paidConfirmedById`/`MatchResult.recordedById`.
model JoinRequest {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  status      JoinRequestStatus @default(pending)
  decidedById String?           @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([matchId, playerId])
  @@index([matchId])
}
