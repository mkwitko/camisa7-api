// Prisma 7 schema. Datasource URL comes from `prisma.config.ts` (Prisma 7
// removed automatic .env loading + inline `datasource.url`), not from here.
//
// Conventions (see docs/superpowers/plans/2026-07-14-futebol-back-fase-0.md
// "DB Conventions (Prisma 7)" — overrides the company skill's DATABASE.md):
// - uuid-only PK: `id String @id @default(uuid()) @db.Uuid` on every model.
//   The `id` IS the public API identifier (no bigint PK, no separate public
//   uuid, no presenter hiding a PK).
// - Timestamps: `createdAt`/`updatedAt` as `Timestamptz(3)`, UTC.
// - No audit-actor columns (created_by/updated_by), no SYSTEM bootstrap.

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

/// Extended in Task 2 (auth): `passwordHash` (own email/password auth, null for
/// Google-only accounts), `googleSub` (Google Sign-In, Task 3+), `expoPushToken`
/// (Task 12). Extended in Task 4: `ownedGroups` (reverse of `Group.ownerId`).
model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique
  name  String

  passwordHash   String?
  googleSub      String? @unique
  expoPushToken  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ownedGroups Group[]
  players     Player[]
}

/// Fase 0 only issues `organizador` (single-owner stats). `colaborativo`
/// (shared editing) is a later fase — the enum value exists now so the
/// column never needs a widening migration.
enum GroupStatsMode {
  organizador
  colaborativo
}

/// Task 4: Arena — an owner-scoped group of players. `id` is the public API
/// identifier (uuid-only PK convention, see header). Ownership authorization
/// (`assertGroupOwner` in `src/http/api/groups/groups.authz.ts`) is the
/// primitive reused by Tasks 5,6,8,9,10,11 — every child resource under a
/// group re-checks `group.ownerId === userId` the same way.
model Group {
  id   String @id @default(uuid()) @db.Uuid
  name String

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  statsMode GroupStatsMode @default(organizador)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members GroupMember[]
  matches Match[]

  @@index([ownerId])
}

/// Task 5: on-field position (goalkeeper..striker). `secondaryPos` on
/// `GroupMember` and the `affinity`/`seedOverall` JSON key sets are both
/// constrained to this same set — the balancer (Task 10) consumes it.
enum Position {
  goleiro
  zagueiro
  lateral
  volante
  meia
  atacante
}

/// Task 5: a member's role inside one specific group (not a global role).
enum MemberRole {
  organizador
  jogador
}

/// Task 5: a person known to the app — either a registered `User` (`userId`
/// set) or a guest added directly by a group organizer (`userId` null, no
/// login). One `Player` can be linked to at most one `User` (via
/// `findOrCreateForUser` in `players.repository.ts`, reused across the same
/// user's groups) — F1-5 closes a Fase 0 TOCTOU gap by making this a REAL DB
/// constraint via a hand-written PARTIAL unique index
/// (`player_user_unique`, covering only non-null `userId`s — see
/// `prisma/migrations/20260715150000_player_user_unique/migration.sql`;
/// Prisma's schema DSL can't express partial uniqueness, so there's no
/// matching `@@unique` here, same as `Attendance`'s
/// `attendance_active_unique`). Guests keep `userId` null, never constrained
/// (many guests, no `User` at all — nothing to enforce uniqueness against).
/// `findOrCreateForUser` catches the P2002 this index can now raise (two
/// concurrent calls racing to provision the same user's `Player`) and
/// re-`findFirst`s instead of surfacing a 500.
model Player {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  name  String
  phone String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships   GroupMember[]
  attendances   Attendance[]
  stats         MatchStat[]
  votesCast     Vote[]        @relation("VoteVoter")
  votesReceived Vote[]        @relation("VoteVoted")
  career        PlayerCareer?

  @@index([userId])
}

/// Task 5: a `Player`'s membership in one `Group`, carrying the carreira-ready
/// rating data (positions + affinity + seed overall) the balancer (Task 10)
/// consumes. `affinity`/`seedOverall` are `Json` maps keyed by `Position`
/// values (validated at the HTTP boundary via Zod, not a DB constraint).
model GroupMember {
  id String @id @default(uuid()) @db.Uuid

  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  role         MemberRole
  primaryPos   Position
  secondaryPos Position[]
  affinity     Json       @default("{}")
  seedOverall  Json       @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([groupId, playerId])
}

/// Task 6: a scheduled pelada. `full` (slots reached) / `closed` (organizer
/// locked it manually) are set by Task 7's attendance flow, not here; `open`
/// is the only status this task's create-match ever sets. `finished` is set
/// by a later task once the match's `datetime` has passed (Task 11's
/// recurrence job also reads `finished` to spawn the next occurrence).
enum MatchStatus {
  open
  full
  closed
  finished
  cancelled
}

/// Task 6: a match (pelada) scheduled inside a `Group` — the aggregate that
/// attendance (Task 7), PIX charges, invites, teams and recurrence (Tasks
/// 8-11) hang off. Only the group's owner manages it (`assertMatchOwner` in
/// `src/http/api/matches/matches.authz.ts`, reusing `assertGroupOwner` on the
/// match's parent group). `recurrenceRule` is a `Json` column — shape
/// `{ weekly: true; weekday: 0-6; time: "HH:mm" } | null` — validated at the
/// HTTP boundary (Zod), not a DB constraint; `null` means a one-off match.
model Match {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @db.Uuid
  group   Group  @relation(fields: [groupId], references: [id])

  datetime       DateTime    @db.Timestamptz(3)
  location       String
  priceCents     Int         @default(0)
  slots          Int
  pixKey         String?
  status         MatchStatus @default(open)
  recurrenceRule Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  attendances    Attendance[]
  inviteTokens   InviteToken[]
  teamAssignment TeamAssignment?
  result         MatchResult?
  stats          MatchStat[]
  votes          Vote[]

  @@index([groupId, datetime])
}

/// Task 7: an attendee's state for one `Match`. `confirmed` counts against
/// `Match.slots`; `waitlisted` carries a 1-based `waitlistPos` (lowest = next
/// to promote); `cancelled` is terminal (a cancelled row never comes back —
/// re-confirming inserts fresh, gated by the partial unique index below so a
/// player can only have one *active* — confirmed/waitlisted — row per match
/// at a time).
enum AttendanceStatus {
  confirmed
  waitlisted
  cancelled
}

/// Task 8: PIX payment confirmation state for a `confirmed` attendee. `paid`
/// is set by `setPayment` once the group owner (or an organizer) marks the
/// attendee's payment as received; `paidConfirmedById` (on `Attendance`)
/// records who did it.
enum PaymentStatus {
  pending
  paid
}

/// Task 7: an attendee's slot/waitlist state for a `Match` — the
/// concurrency-critical aggregate. Every state transition (`confirm`,
/// `cancelAndPromote`) runs inside one interactive `prisma.$transaction`
/// that locks the parent `Match` row first (`SELECT ... FOR UPDATE` — see
/// `attendance.repository.ts`), so two concurrent confirms can never both
/// take the last slot. Prisma's schema DSL can't express a *partial* unique
/// index, so the real constraint enforcing "at most one active (non
/// cancelled) row per (matchId, playerId)" is hand-added as raw SQL in this
/// model's migration (`attendance_active_unique`) — see the migration file's
/// header comment for why it can't live here.
model Attendance {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  status      AttendanceStatus
  waitlistPos Int?

  paymentStatus     PaymentStatus @default(pending)
  paidConfirmedById String?       @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([matchId])
  @@index([playerId])
}

/// Task 9: a shareable link an owner mints for one `Match` — the viral-loop
/// surface. A guest (no account) resolves it via the public `GET
/// /invite/:token` and confirms presence via the public `POST
/// /invite/confirm`, which creates a guest `Player` (`userId` null) and runs
/// the same race-safe `AttendanceRepository.confirm` flow Task 7 uses for
/// authenticated confirms. `token` is a `nanoid(16)` string minted by
/// `invites.repository.ts`'s `create` — that same method reuses the existing
/// row for a match instead of minting a new one on every call, so there's no
/// uniqueness constraint on `matchId` (one row is the steady state, but
/// nothing in the schema itself forbids more).
model InviteToken {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  token String @unique

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([matchId])
}

/// Task 10: the last-generated (or owner-overridden) team split for a
/// `Match` — one row per match (`matchId` unique; `TeamsRepository.save` is
/// an upsert keyed by `matchId`, so `generate-teams`/`update-teams` always
/// replace the same row rather than accumulate history). `teams` is a `Json`
/// array shaped `{ team: number; players: { playerId: string; name: string
/// }[] }[]` — produced by the pure `balanceTeams` (`children/teams/
/// balancer.ts`) or by `update-teams`'s own "every confirmed player exactly
/// once" check, not a DB constraint. `updatedAt` doubles as the domain
/// `TeamAssignment.generatedAt` (every `save` bumps it, whether from a fresh
/// generation or a manual override).
model TeamAssignment {
  id String @id @default(uuid()) @db.Uuid

  matchId String @unique @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  teams Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Task 14 (Fase 1): closes out a `Match` — the owner-recorded final score.
/// One row per match (`matchId` unique; `MatchResultRepository.upsert` is an
/// upsert keyed by `matchId`, so `record-result` can correct a mistaken entry
/// by resubmitting rather than accumulating history). `scores` is a `Json`
/// array shaped `{ team: number; goals: number }[]` — same `{ team, ... }[]`
/// convention `TeamAssignment.teams` uses, validated at the HTTP boundary
/// (Zod) plus cross-checked in the service against the match's persisted
/// `TeamAssignment` (if one exists) so a score can't reference a team that
/// was never on the pitch. `winnerTeam` is the winning team's index;
/// `null` means a draw. `recordedById` is the acting `User.id` — plain uuid
/// column, no FK relation, same convention as `Attendance.paidConfirmedById`.
/// Recording a result requires the match to already be `status: "finished"`
/// (via `finish-match`, Fase 0) — `record-result` doesn't itself transition
/// match status, it only closes out the score for an already-finished match.
model MatchResult {
  id String @id @default(uuid()) @db.Uuid

  matchId String @unique @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  scores     Json
  winnerTeam Int?

  recordedById String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Task 15 (Fase 1): F1-2 organizer-logged per-player stats for a `Match`.
/// Fase 1 only ever writes `source: "organizador"` (the owner logs
/// gols/assist/clean_sheet after the match) — `colaborativo` (jogadores
/// reportam + consenso/disputa, `stat_report`) is a later fase; the enum
/// value exists now so this column never needs a widening migration when
/// that feature lands (see §4.2/§9 of the Fase 0+1 design doc).
enum MatchStatSource {
  organizador
  colaborativo
}

/// Task 15 (Fase 1): one player's stat line for one `Match` — `log-stats`
/// upserts a batch of these keyed by `(matchId, playerId)`
/// (`MatchStatsRepository.upsertMany`), so re-logging the same player
/// corrects the row rather than accumulating history (same "upsert to
/// correct" convention `MatchResult`/`TeamAssignment` use). `team` is the
/// same 0-based index `TeamScore.team`/`TeamSplit.team` use — optional
/// since not every group runs `generate-teams` before logging stats.
/// `cleanSheet` only makes sense for a goalkeeper but isn't itself
/// constrained to `Position.goleiro` at the DB level (validated, if at all,
/// at the HTTP boundary). `listByPlayer` (career-wide, ignores `matchId`)
/// feeds the F1-4 career-growth engine (`player_career`, §6 of the design
/// doc) once it lands.
model MatchStat {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  team       Int?
  goals      Int             @default(0)
  assists    Int             @default(0)
  ownGoals   Int             @default(0)
  cleanSheet Boolean         @default(false)
  source     MatchStatSource @default(organizador)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([matchId, playerId])
  @@index([playerId])
}

/// Task 16 (Fase 1, F1-3): the 4 post-game recognition categories a
/// confirmed attendee can vote for. `craque` is Portuguese for the match's
/// standout player (distinct from `mvp` — the design doc's §4.2 lists them
/// as separate categories); `fair_play` feeds a reputation signal (§6)
/// that's kept separate from the technical `overall` a `craque`/`mvp` vote
/// nudges.
enum VoteCategory {
  mvp
  melhor_goleiro
  craque
  fair_play
}

/// Task 16 (Fase 1, F1-3): one player's vote, for one category, on one
/// `Match` — `cast-vote` upserts keyed by `(matchId, voterPlayerId,
/// category)` (`VotesRepository.upsert`), so changing your mind within the
/// 48h voting window (§5.2 step 10 of the design doc) corrects the same row
/// rather than accumulating history (same "upsert to correct" convention
/// `MatchResult`/`MatchStat` use). Both `voterPlayerId` and `votedPlayerId`
/// point at `Player` — two separate relations (`VoteVoter`/`VoteVoted`,
/// named since Prisma requires disambiguation for two FKs to the same
/// model), mirrored by `Player.votesCast`/`Player.votesReceived`. The
/// service layer (`cast-vote.service.ts`), not a DB constraint, enforces
/// that both players are CONFIRMED attendees of `matchId` and that
/// `voterPlayerId !== votedPlayerId` (no self-vote) — Prisma's schema DSL
/// can't express either check. Individual rows are never exposed over the
/// API (`list-vote-tally` only returns aggregated counts, see
/// `votes.repository.ts`'s `tallyByMatch`) — voter identity per vote stays
/// private, only `listByMatch` (internal, feeds the F1-4 career-growth
/// engine's MVP/craque counts) reads the raw rows.
model Vote {
  id String @id @default(uuid()) @db.Uuid

  matchId String @db.Uuid
  match   Match  @relation(fields: [matchId], references: [id])

  voterPlayerId String @db.Uuid
  voter         Player @relation("VoteVoter", fields: [voterPlayerId], references: [id])

  category VoteCategory

  votedPlayerId String @db.Uuid
  voted         Player @relation("VoteVoted", fields: [votedPlayerId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([matchId, voterPlayerId, category])
  @@index([matchId])
  @@index([votedPlayerId])
}

/// Task 17 (Fase 1, F1-4): a player's GLOBAL, cross-group identity — 1:1 with
/// `Player`, materialized for any player (registered or guest; guest→account
/// merge is F1-5). Grows deterministically off match history via the pure
/// growth engine (`src/http/api/players/children/career/career-engine.ts`),
/// replayed by `PlayerCareerRepository.recomputeForPlayer` (triggered by
/// `POST /matches/:id/finalize` and the finalize cron, `src/jobs/
/// finalize-matches.job.ts`) — never mutated incrementally, so recomputing
/// twice from the same match history yields the same row (idempotent).
/// `overall`/`affinity` are `Json` maps keyed by `Position` (0-99 / 0-100),
/// same convention `GroupMember.seedOverall`/`affinity` use — `affinity` is
/// player-declared (set outside this task's scope) and the engine never
/// writes it, only `overall`. `level` is derived from the best `overall`
/// entry via `career-config.ts`'s thresholds. `currentStreak` is the
/// player's active unbeaten (win/draw) run as of their most recent finalized
/// match; `bestStreak` is the historical max.
model PlayerCareer {
  id String @id @default(uuid()) @db.Uuid

  playerId String @unique @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  overall  Json @default("{}")
  affinity Json @default("{}")

  level PlayerLevel @default(bronze)

  matchesPlayed Int @default(0)
  wins          Int @default(0)
  draws         Int @default(0)
  losses        Int @default(0)
  goals         Int @default(0)
  assists       Int @default(0)
  cleanSheets   Int @default(0)
  mvpCount      Int @default(0)
  currentStreak Int @default(0)
  bestStreak    Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Task 17 (Fase 1, F1-4): `PlayerCareer.level` — derived (never set
/// directly by a caller) from the player's best per-position `overall` via
/// `career-config.ts`'s `LEVEL_THRESHOLDS`. bronze is the default for a
/// brand-new career (bootstrap seed, or no positions touched yet).
enum PlayerLevel {
  bronze
  prata
  ouro
}
