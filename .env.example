# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3333

# Postgres 16 (docker-compose service `postgres`, see docker-compose.yml).
DATABASE_URL=postgres://futebol:futebol@localhost:5432/futebol

# Own JWT auth (access + refresh) — any string >= 16 chars for local dev.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of accepted Google OAuth client ids (Google Sign-In).
GOOGLE_CLIENT_IDS=

# Optional: Expo push notifications access token.
EXPO_ACCESS_TOKEN=

# Trusted reverse-proxy hops (e.g. ALB) for req.ip resolution.
TRUST_PROXY_HOPS=1
