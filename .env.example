# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3333

# Postgres 16 on Neon (managed). Local dev talks to Neon directly — no local Docker DB.
# Use the Neon connection string (pooled endpoint recommended); SSL is required.
# e.g. postgresql://<user>:<pass>@<endpoint>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/futebol?sslmode=require

# Own JWT auth (access + refresh) — any string >= 16 chars for local dev.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of accepted Google OAuth client ids (Google Sign-In).
GOOGLE_CLIENT_IDS=

# Firebase Cloud Messaging (push). Path to the service-account JSON downloaded
# from Firebase Console > Project Settings > Service accounts > Generate new
# private key. Read by firebase-admin (Application Default Credentials).
# Leave unset to disable push (sends become no-ops).
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Trusted reverse-proxy hops (e.g. ALB) for req.ip resolution.
TRUST_PROXY_HOPS=1

# Cloudflare R2 (object storage) — presigned avatar/media uploads. Optional (upload off when unset).
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://<public-bucket>.r2.dev

# Stripe billing + entitlements. Optional/config-gated: leave STRIPE_SECRET_KEY
# unset to disable billing (/billing/* → 503, hasFeature false), same as R2/push.
STRIPE_SECRET_KEY=
# Signing secret for the POST /webhooks/stripe endpoint (Stripe CLI / dashboard).
STRIPE_WEBHOOK_SECRET=
# Price ids of the subscription plans (from the Stripe dashboard).
STRIPE_PRICE_ORGANIZER=
STRIPE_PRICE_PLAYER=
# Comma-separated allowlist of store-reviewer accounts. These emails get every
# feature and paymentsEnabled:false, so the app hides all in-app payment UI.
REVIEWER_EMAILS=
# Deep-link scheme for checkout/portal return URLs.
APP_DEEPLINK_SCHEME=futebolapp

# Marketplace V2 (booking + Stripe Connect): platform fee applied to each
# PaymentIntent's application_fee_amount = max(priceCents*BPS/10000, MIN_CENTS).
# Basis points (500 = 5%).
PLATFORM_FEE_BPS=500
# Minimum fee floor, in cents.
PLATFORM_FEE_MIN_CENTS=200
