# @prisma/client declares an OPTIONAL peerDependency on the `prisma` CLI
# package (for embedding Prisma Studio, etc.). With pnpm's default
# auto-install-peers=true, pnpm still resolves+installs a full separate copy
# of that optional peer (pulling in @prisma/studio-core, @prisma/dev,
# effect, @electric-sql/pglite, a bundled typescript-linux-x64 binary...)
# into node_modules/.pnpm even for a `--prod` install with no devDependencies
# — none of it reachable from our code, but it still ends up copied into the
# production Docker image (~300MB of dead weight). Disabling auto-install
# for peers avoids that: every peer this project actually needs (prisma,
# typescript, zod, ...) is already an explicit dependency/devDependency, so
# nothing breaks — pnpm just stops fabricating extra copies to satisfy
# *optional* peers we never use.
auto-install-peers=false
